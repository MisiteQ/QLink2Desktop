#!/bin/bash
# 安装后钩子。
#
# QLink2Desktop 不在安装期做任何重活：
# 它会在**首次启动**后的对账阶段，自行把用户配置的端口 / 容器
# 注册成桌面图标（见 internal/app 的 Supervise 与 Reconcile）。
#
# 这里只负责一件事：确保旧的统一网关套接字不会残留在目标目录里。
# 残留的套接字会让网关把请求转发到一个已经不存在的服务上，
# 表现为「安装完点开图标一直 502」，而且很难排查。
set -u

rm -f "${TRIM_APPDEST:-}/app.sock" 2>/dev/null || true

exit 0
