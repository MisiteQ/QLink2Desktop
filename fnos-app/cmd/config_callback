#!/bin/bash
# 配置变更后钩子。
#
# 若用户在应用环境里改了 PORT 环境变量，需要重启服务才能生效。
# 这里只做一次温和的 TERM，让飞牛应用中心按 ctl_stop 的语义重新拉起；
# 失败也不阻塞配置流程。
set -u

TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/qlink2desktop/var}"
PID_FILE="${TRIM_PKGVAR}/app.pid"

if [ -r "${PID_FILE}" ]; then
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill -TERM "${pid}" 2>/dev/null || true
    fi
fi

exit 0
